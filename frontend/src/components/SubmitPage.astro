---
import Shell from '../layouts/Shell.astro';
import {SubmitForm} from './submit-form';
import {getMessages,type Locale} from '../lib/i18n';
import {pathFor} from '../lib/catalog';
interface Props {locale:Locale}
const {locale}=Astro.props;
---
<Shell locale={locale} title="Submit an MCP app or connector" description="Submit an MCP app, ChatGPT app, or Claude connector for review with metadata, previews, tools, and platform details." path="/submit">
<SubmitForm client:load locale={locale} messages={getMessages(locale).submitForm} action={pathFor(locale,'/api/submit')} previewOnly={true}/>
</Shell>
<style is:global>
.prototype-notice{padding:20px;border:2px solid #bb7700;background:#fff5d8;border-radius:12px;margin-bottom:24px;font-weight:600}.page-head h1{font-size:40px}.import-card,.card,.preview-card{background:white;padding:24px;border:1px solid #dce5de;border-radius:12px;margin:20px 0}.field{margin:18px 0}.field label,.field>span{display:block;font-weight:600;margin-bottom:6px}input:not([type=checkbox]):not([type=radio]):not([type=hidden]),textarea,select{font:inherit;max-width:100%;width:100%;padding:12px;border:1px solid #b8c9bf;border-radius:7px}textarea{min-height:120px}.input-row,.form-row,.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}button{font:inherit;padding:10px 16px;border:1px solid #bacbbf;border-radius:8px;margin:8px 8px 8px 0;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}svg{width:20px;height:20px;vertical-align:middle}.submit-bar,.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.avatar-preview,.preview-avatar{width:80px;height:80px;overflow:hidden;background:#e5eee6;border-radius:18px;display:grid;place-items:center}.avatar-preview img,.preview-avatar img{width:100%;height:100%;object-fit:cover}.preview-image{max-width:100%;height:auto}.platform-icon{display:inline-grid;place-items:center;width:28px;height:28px;background:#e5eee6;border-radius:6px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0)}.chip,.tag{display:inline-block;margin:4px}.btn-primary{background:#145d45;color:white}.step{font-size:12px;text-transform:uppercase;letter-spacing:1px}.hint,.card-sub,.field-hint{color:#5d7567;font-size:14px}.preview-card{max-width:600px}@media(max-width:600px){.input-row,.form-row,.grid-2{grid-template-columns:1fr}}
</style>
