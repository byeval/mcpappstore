---
import ProductionApp from '../production/ProductionApp.astro';
import {productionApp,productionData} from '../production/lib/build-data';
import {canonicalAppId} from '../production/lib/catalog-identity';
import {localizedAppSeoTitle,localizedAppDescription} from '../production/lib/seo';
import Shell from '../layouts/Shell.astro';
import {relatedApps, blockedPaths, supportedLocales, visibleApps, categories, categoryApps,pathFor,pageSize,safeLink,type App} from '../lib/catalog';
import {getMessages,formatMessage,type Locale} from '../lib/i18n';
import {type LearnArticle} from '../lib/learn';
import {appTitle,metaDescription,categoryIndexable,breadcrumb,faqSchema,implementedPath,mediaUrl,publicSources,appPreviews,type RichApp} from '../lib/parity';
import {listCollectionApps, COLLECTION_APP_LIMIT, type AppCollection} from '../lib/collections';
import {visibleSkills,skillPath,pairedApps,skillSource,installCommand,skillFaq,type Skill} from '../lib/skills';
import {fixedPaths,indexKeys,indexApps,platformApps,platformCopy,fixedCopy,editorial} from '../lib/public-pages';
import {localizedLearnArticles,localizedAppCollections,localizedCategoryContent,localizedCategoryName} from '../lib/content-i18n';
export function getStaticPaths(){
 const routes: Array<{params:{path:string|undefined};props:Record<string,unknown>}> = [];
 for(const locale of supportedLocales){
 const add=(path:string,kind:string,extra:Record<string,unknown>={})=>{if(blockedPaths.some(p=>decodeURIComponent(p)===decodeURIComponent(pathFor(locale,path))))return;routes.push({params:{path:decodeURIComponent(pathFor(locale,path)).replace(/^\//,'')||undefined},props:{locale,kind,path,...extra}});};
 if(import.meta.env.ASTRO_CURRENT_RELEASE==='true'){for(const path of ['/docs','/privacy','/terms','/faq'])add(path,path.slice(1));for(const article of localizedLearnArticles(locale))add(`/learn/${article.slug}`,'learn',{article});for(const app of visibleApps(locale)){if(canonicalAppId(productionApp(app))===app.id)add(`/app/${app.id}`,'app',{app});}continue;}
 if(import.meta.env.ASTRO_APP_PILOT==='true'){for(const app of visibleApps(locale).filter(a=>['canva','adobe','adobe-formerly-photoshop','github','data','data-analytics'].includes(a.id)))add(`/app/${app.id}`,'app',{app});continue;}
 if(import.meta.env.ASTRO_AUDITED_ONLY==='true'){for(const path of ['/docs','/privacy','/terms','/faq'])add(path,path.slice(1));for(const article of localizedLearnArticles(locale))add(`/learn/${article.slug}`,'learn',{article});continue;}
 for(const path of fixedPaths)add(path,path.slice(1),{items:path==='/store'?indexApps(locale):[]});
 for(const key of indexKeys){const items=indexApps(locale,key);if(items.length)add(`/store/${key.toLowerCase()}`,'store',{indexLetter:key,items});}
 for(const platform of ['chatgpt','claude'] as const){const all=platformApps(locale,platform),root=platform==='chatgpt'?'/chatgpt-apps':'/claude-connectors',pages=Math.max(1,Math.ceil(all.length/pageSize));for(let page=1;page<=pages;page++)add(`${root}${page>1?`/page/${page}`:''}`,'platform',{platform,items:all.slice((page-1)*pageSize,page*pageSize),page,pages,total:all.length});}
 add('/','home');add('/learn','learnIndex');add('/collections','collectionsIndex');add('/skills','skillsIndex');
 for(const collection of localizedAppCollections(locale))add(`/collections/${collection.slug}`,'collection',{collection,items:listCollectionApps(collection,visibleApps(locale)).slice(0,COLLECTION_APP_LIMIT)});
 for(const skill of visibleSkills(locale))add(skillPath(skill.id),'skill',{skill});
 for(const app of visibleApps(locale)) add(`/app/${app.id}`,'app',{app});
 for(const category of categories){const members=categoryApps(locale,category.slug);const pages=Math.max(1,Math.ceil(members.length/pageSize));for(let page=1;page<=pages;page++)add(`/category/${category.slug}${page===1?'':`/page/${page}`}`,'category',{category,items:members.slice((page-1)*pageSize,page*pageSize),page,pages,total:members.length});}
 for(const article of localizedLearnArticles(locale))add(`/learn/${article.slug}`,'learn',{article});
 }
 return import.meta.env.ASTRO_APP_PILOT==='true'?routes:import.meta.env.ASTRO_AUDITED_ONLY==='true'?routes.filter(r=>['docs','privacy','terms','faq','learn'].includes(String(r.props.kind))):routes;
}
interface Props{locale:Locale;kind:string;path:string;app?:App;category?:{slug:string;name:string};items?:App[];page?:number;pages?:number;total?:number;article?:LearnArticle;collection?:AppCollection;skill?:Skill;platform?:'chatgpt'|'claude';indexLetter?:string}
const {locale,kind,path,app,category,items=[],page=1,pages=1,total,article,collection,skill,platform,indexLetter}=Astro.props;
const t=getMessages(locale);
const fixed=fixedCopy(kind,locale,indexLetter);
const platformText=platform?platformCopy(locale,platform):undefined;
const categoryName=category?localizedCategoryName(category.slug,category.name.replace(/-/g,' '),locale):undefined;
const categoryGuide=category?localizedCategoryContent(category.slug,categoryName!,total??0,locale):undefined;
const fullApp=app?productionApp(app):undefined;
const fullData=fullApp?productionData(locale):undefined;
const richApp=app as RichApp|undefined;
const title=(fullApp?localizedAppSeoTitle(fullApp,locale):undefined)??fixed?.title??(platformText?`${platformText.title} - MCP${page>1?(locale==='zh-hans'?` - 第 ${page} 页`:` - Page ${page}`):''}`:undefined)??(richApp?appTitle(richApp):undefined)??article?.title??collection?.title??(skill?`${skill.displayName} agent skill`:undefined)??(kind==='collectionsIndex'?'MCP app collections':kind==='skillsIndex'?'Agent skills directory':undefined)??(category?`${formatMessage(t.categoryPage.title,{category:categoryName!})}${page>1?` · Page ${page}`:''}`:kind==='learnIndex'?t.nav.learn:'MCP App Store');
const description=(fullApp?localizedAppDescription(fullApp,locale):undefined)??fixed?.description??(platformText?metaDescription(platformText.body[0]):undefined)??categoryGuide?.metaDescription??metaDescription(app?`${title}. ${app.tagline||app.description}`:article?.description??collection?.description??skill?.description??(category?`Compare ${total} ${category.name} MCP apps, ChatGPT apps, Claude connectors, and MCP servers by tools, platform support, previews, and integration details.`:'Explore apps, tools and MCP connectors.'));
const canonicalPath=fullApp?`/app/${canonicalAppId(fullApp)}`:platform?`${platform==='chatgpt'?'/chatgpt-apps':'/claude-connectors'}${page>1?`?page=${page}`:''}`:category?`/category/${category.slug}${page>1?`?page=${page}`:''}`:path;
const mainSchema=app?{'@context':'https://schema.org','@type':'SoftwareApplication',name:app.name,description:app.description,url:`https://mcpapp.net${pathFor(locale,path)}`,applicationCategory:app.categories.join(', '),operatingSystem:'Web',image:mediaUrl(app.iconKey),author:{'@type':'Organization',name:app.publisher}}:article?{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,dateModified:article.updatedAt,datePublished:article.updatedAt,mainEntityOfPage:`https://mcpapp.net${pathFor(locale,path)}`,author:{'@type':'Organization',name:'MCP App Store',url:'https://mcpapp.net/'},publisher:{'@type':'Organization',name:'MCP App Store',url:'https://mcpapp.net/'}}:(category||collection||platform||kind==='store')?{'@context':'https://schema.org','@type':'ItemList',itemListElement:items.map((a,i)=>({'@type':'ListItem',position:(page-1)*pageSize+i+1,name:a.name,url:`https://mcpapp.net${pathFor(locale,`/app/${a.id}`)}`}))}:undefined;
const crumbs=[{name:t.nav.browse,path:'/'},...(article?[{name:t.nav.learn,path:'/learn'}]:[]),...(collection?[{name:'Collections',path:'/collections'}]:[]),...(skill?[{name:'Skills',path:'/skills'}]:[]),...(kind==='home'?[]:[{name:app?.name??title,path:canonicalPath}])];
const schema=[...(mainSchema?[mainSchema]:[]),breadcrumb(crumbs,locale),...(article?.faqs?.length?[faqSchema(article.faqs)]:[]),...(collection?.faqs?.length?[faqSchema(collection.faqs)]:[]),...(skill?[faqSchema(skillFaq(skill,locale))]:[]),...(fixed?.faqs.length?[faqSchema(fixed.faqs)]:[]),...(platformText?[faqSchema(platformText.faqs)]:[]),...(categoryGuide?.faqs.length?[faqSchema(categoryGuide.faqs)]:[])];
const previews=richApp?appPreviews(richApp):[];
const image=richApp?mediaUrl(richApp.iconKey,richApp.iconUrl):undefined;
const related=app?relatedApps(locale,app):[];
const liveLink=(value:string)=>value.startsWith('/')&&!value.startsWith('//')?pathFor(locale,value):safeLink(value);
const articleLinks=article?article.relatedLinks.flatMap(l=>{const href=liveLink(l.href);return href?[{...l,href}]:[];}):[];
const articleApps=article?.featuredAppIds?visibleApps(locale).filter(a=>article.featuredAppIds!.includes(a.id)):[];
const currentCollections=localizedAppCollections(locale).filter(c=>!blockedPaths.includes(pathFor(locale,`/collections/${c.slug}`)));
const currentSkills=visibleSkills(locale);
const pairing=skill?pairedApps(skill.id,locale):[];
const collectionLinks=collection?collection.relatedLinks.flatMap(l=>{const p=implementedPath(l.href,locale);return p?[{...l,href:p}]:[];}):[];
const listing=kind==='home'?visibleApps(locale).slice(0,36):items;
---
<Shell locale={locale} title={title} description={article?.description??description} path={canonicalPath} schema={app?undefined:schema} robots={category&&!categoryIndexable(category.slug,total??0)?"noindex, follow":undefined} image={image} article={!!article} modified={article?.updatedAt}>
{fullApp&&fullData?<ProductionApp app={fullApp} publishedApps={fullData.apps} categories={fullData.categories} locale={locale}/>:<>
<nav aria-label="Breadcrumb" class="crumbs">{crumbs.map((c,i)=><>{i>0&&<span aria-hidden="true">/</span>}{i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<a href={pathFor(locale,c.path)}>{c.name}</a>}</>)}</nav>
<p class="eyebrow">{kind==='app'?'App directory':kind==='learn'?'Learn':kind==='category'?'Explore a category':'MCP App Store'}</p><h1>{app?.name??skill?.displayName??fixed?.heading??platformText?.title??title}</h1><p class="lead">{article?.description??description}</p>
{app&&<>{image&&<img class="app-icon" src={image} alt={`${app.name} icon`} width="80" height="80"/>}<p>{app.publisher}{richApp?.version&&` · ${richApp.version}`}</p><div class="chips">{app.categories.slice(0,12).map((slug:string)=><a class="chip" href={pathFor(locale,`/category/${slug}`)}>{slug}</a>)}</div>{safeLink(app.homepageUrl)&&<a class="button" href={safeLink(app.homepageUrl)} rel="noopener noreferrer">Visit website ↗</a>}<section class="detail"><p>{app.description}</p></section><div class="chips">{app.capabilities?.map((c:string)=><span class="chip">{c}</span>)}</div>{previews.length>0&&<section><h2>Previews</h2><div class="preview-grid">{previews.map(p=><figure><img src={p.image} alt={p.caption||p.prompt||`${app.name} preview`} loading="lazy"/><figcaption>{p.caption||p.prompt}</figcaption></figure>)}</div></section>}{richApp&&<nav aria-label="Publisher resources" class="source-links">{publicSources(richApp).map(l=><a href={l.href} rel="noopener noreferrer">{l.label}</a>)}</nav>}{richApp?.surfaces?.filter(s=>s.status==='available'&&safeLink(s.url)).map(s=><a class="button" href={safeLink(s.url)} rel="noopener noreferrer">Open in {s.platform==='claude'?'Claude':'ChatGPT'}</a>)}{(richApp?.tools?.length??0)>0&&<section><h2>Tools</h2>{richApp?.tools?.map(tool=><div><h3>{tool.name||tool.tool_name}</h3><p>{tool.description}</p></div>)}</section>}{app.examplePrompts?.length>0&&<section><h2>Example prompts</h2>{app.examplePrompts.map((p:string)=><blockquote>{p}</blockquote>)}</section>}</>}
{(kind==='home'||kind==='category'||kind==='collection'||kind==='platform'||kind==='store')&&<><div class="grid">{listing.map(a=><article class="card"><h2><a href={pathFor(locale,`/app/${a.id}`)}>{a.name}</a></h2><p>{a.tagline}</p><small>{a.publisher}</small></article>)}</div>{(category||platform)&&<nav class="pager">{page>1&&<a href={`${pathFor(locale,category?`/category/${category.slug}`:platform==='chatgpt'?'/chatgpt-apps':'/claude-connectors')}${page===2?'':`?page=${page-1}`}`}>← Previous</a>}<span>{page} / {pages}</span>{page<pages&&<a href={`${pathFor(locale,category?`/category/${category.slug}`:platform==='chatgpt'?'/chatgpt-apps':'/claude-connectors')}?page=${page+1}`}>Next →</a>}</nav>}{kind==='home'&&<><h2>Categories</h2><div class="chips">{categories.slice(0,40).map(c=><a class="chip" href={pathFor(locale,`/category/${c.slug}`)}>{c.name}</a>)}</div></>}</>}
{related.length>0&&<section><h2>Related apps</h2><div class="grid">{related.map(a=><article class="card"><h3><a href={pathFor(locale,`/app/${a.id}`)}>{a.name}</a></h3><p>{a.tagline}</p></article>)}</div></section>}
{kind==='learnIndex'&&<div class="grid">{localizedLearnArticles(locale).map(a=><article class="card"><h2><a href={pathFor(locale,`/learn/${a.slug}`)}>{a.title}</a></h2><p>{a.description}</p></article>)}</div>}
{article&&<article class="detail" lang={article.contentLanguage??locale}>{article.translationStatus==='original'&&<p class="translation-note">{locale==='zh-hans'?'本文完整正文暂为英文。以下显示原文，避免以简略摘要代替操作指南。':'The full guide is currently available in English. The original text is shown below.'} <a href={`/learn/${article.slug}`}>English →</a></p>}<nav class="source-links">{[article.primaryCta,article.secondaryCta].filter(Boolean).map(l=>l&&liveLink(l.href)&&<a class="button" href={liveLink(l.href)}>{l.label}</a>)}</nav><p>{article.readingTime} · <time datetime={article.updatedAt}>{formatMessage(t.common.updated,{date:article.updatedAt})}</time></p><p>{article.summary}</p><nav aria-label="On this page"><ul>{article.sections.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul></nav>{article.sections.map(s=><section id={s.id}><h2>{s.title}</h2>{s.body.map(p=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}{s.steps&&<ol>{s.steps.map(b=><li>{b}</li>)}</ol>}{s.code&&<pre><code>{s.code}</code></pre>}{s.callout&&<blockquote>{s.callout}</blockquote>}</section>)}{articleApps.length>0&&<section><h2>{t.learnArticle.relevantApps}</h2><div class="grid">{articleApps.map(a=><article class="card"><h3><a href={pathFor(locale,`/app/${a.id}`)}>{a.name}</a></h3><p>{a.tagline}</p></article>)}</div></section>}{article.faqs?.map(f=><details class="faq"><summary>{f.question}</summary><p>{f.answer}</p></details>)}{article.sources.length>0&&<section><h2>{t.learnArticle.sources}</h2><ul>{article.sources.filter(s=>safeLink(s.url)).map(s=><li><a href={safeLink(s.url)} rel="noopener noreferrer">{s.label}</a></li>)}</ul></section>}{articleLinks.length>0&&<section><h2>{t.learnArticle.related}</h2><ul>{articleLinks.map(l=><li><a href={l.href}>{l.label}</a></li>)}</ul></section>}</article>}
{kind==='collectionsIndex'&&<div class="grid">{currentCollections.map(c=><article class="card"><p class="eyebrow">{c.eyebrow}</p><h2><a href={pathFor(locale,`/collections/${c.slug}`)}>{c.title}</a></h2><p>{c.description}</p></article>)}</div>}
{collection&&<article class="detail"><p>{collection.summary}</p><p>Updated <time datetime={collection.updatedAt}>{collection.updatedAt}</time></p><h2>How to choose</h2><ul>{collection.checkpoints.map(c=><li>{c}</li>)}</ul><section><h2>FAQ</h2>{collection.faqs.map(f=><details class="faq"><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>{collectionLinks.length>0&&<section><h2>{t.learnArticle.related}</h2><ul>{collectionLinks.map(l=><li><a href={l.href}>{l.label}</a></li>)}</ul></section>}</article>}
{kind==='skillsIndex'&&<><p>Historical public skills fixture, not live D1. Search/filter behavior requires the dynamic migration adapter.</p><div class="grid">{currentSkills.map(s=><article class="card"><p class="eyebrow">{s.sourceType}</p><h2><a href={pathFor(locale,skillPath(s.id))}>{s.displayName}</a></h2><p>{s.description}</p><div class="chips">{s.categories.slice(0,3).map(c=><span class="chip">{c}</span>)}</div></article>)}</div></>}
{skill&&<article class="detail"><p>Historical public skills fixture, not live D1.</p><h2>Skill metadata</h2><dl><dt>Skill ID</dt><dd><code>{skill.id}</code></dd><dt>Source</dt><dd>{skill.sourceType}</dd><dt>Status</dt><dd>{skill.status}</dd></dl>{skillSource(skill)&&<a class="button" href={skillSource(skill)} rel="noopener noreferrer">Open source</a>}{installCommand(skill)&&<><h2>Install</h2><pre><code>{installCommand(skill)}</code></pre><p>Review third-party code and permissions before installing.</p></>}<div class="chips">{[...skill.categories,...skill.tags].map(tag=><span class="chip">{tag}</span>)}</div><h2>Paired MCP apps</h2>{pairing.length?<div class="grid">{pairing.map(p=><article class="card"><h3><a href={pathFor(locale,`/app/${p.app.id}`)}>{p.app.name}</a></h3><p>{p.reason}</p><small>{p.relationType}</small></article>)}</div>:<p>No curated MCP app pairings yet.</p>}<h2>FAQ</h2>{skillFaq(skill,locale).map(f=><details class="faq"><summary>{f.question}</summary><p>{f.answer}</p></details>)}</article>}
{kind==='store'&&<nav aria-label="Alphabetical app index" class="chips">{indexKeys.filter(k=>indexApps(locale,k).length).map(k=><a class="chip" href={pathFor(locale,`/store/${k.toLowerCase()}`)}>{k}</a>)}</nav>}
{fixed&&<article class="detail">{fixed.body.map(p=><p>{p}</p>)}{fixed.faqs.map(f=><details class="faq"><summary>{f.question}</summary><p>{f.answer}</p></details>)}</article>}
{kind==='docs'&&<><dl>{[[t.docs.surfacesKey,t.docs.surfacesValue],[t.docs.basicsKey,t.docs.basicsValue],[t.docs.previewsKey,t.docs.previewsValue],[t.docs.mcpDetailsKey,t.docs.mcpDetailsValue],[t.docs.reviewKey,t.docs.reviewValue]].map(([key,value])=><><dt><h2>{key}</h2></dt><dd>{value}</dd></>)}</dl><nav><a href={pathFor(locale,'/learn/build-your-first-mcp-app')}>{t.common.buildFirstApp}</a> · <a href={pathFor(locale,'/faq')}>{t.common.readFaq}</a></nav></>}
{(kind==='mcp-directory'||kind==='chatgpt-connectors')&&<><h2>{editorial[kind].headings[0]}</h2><ul>{editorial[kind].checklist.map(p=><li>{p}</li>)}</ul><nav class="chips"><a href={pathFor(locale,'/chatgpt-apps')}>ChatGPT apps</a><a href={pathFor(locale,'/claude-connectors')}>Claude connectors</a><a href={pathFor(locale,'/store')}>MCP App Store</a></nav></>}
{platformText&&<article class="detail">{platformText.body.map(p=><p>{p}</p>)}{platformText.faqs.map(f=><details class="faq"><summary>{f.question}</summary><p>{f.answer}</p></details>)}</article>}
{categoryGuide&&<article class="detail"><p class="eyebrow">{categoryGuide.eyebrow}</p><h2>{categoryGuide.title}</h2>{categoryGuide.body.map(p=><p>{p}</p>)}<ul>{categoryGuide.checkpoints.map(p=><li>{p}</li>)}</ul>{categoryGuide.faqs.map(f=><details class="faq"><summary>{f.question}</summary><p>{f.answer}</p></details>)}</article>}
</>}
</Shell>
