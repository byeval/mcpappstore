{
  "name": "mcpapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext deploy",
    "check": "tsc --noEmit",
    "cf-types": "wrangler types",
    "crawl:daily": "bash scripts/daily-crawl.sh",
    "crawl:webhook": "node --import tsx scripts/crawl-webhook.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "media:webp": "node --import tsx scripts/convert-seed-media-to-webp.ts",
    "media:thumbs": "node --import tsx scripts/generate-preview-thumbnails.ts",
    "scrape": "node --import tsx scripts/scrape-chatgpt.ts",
    "scrape:claude": "node --import tsx scripts/scrape-claude.ts",
    "scrape:claude-connectors": "node --import tsx scripts/scrape-claude-connectors.ts",
    "clients:import": "node --import tsx scripts/import-mcp-clients.ts",
    "data:health": "node --import tsx scripts/data-source-health.ts",
    "discover:github-mcp": "node --import tsx scripts/discover-github-mcp.ts",
    "discovery:index": "node --import tsx scripts/build-discovery-index.ts",
    "import:github-mcp": "node --import tsx scripts/import-github-mcp-candidates.ts",
    "skills:refresh": "node --import tsx scripts/refresh-skills.ts",
    "skills:import:skills-sh": "node --import tsx scripts/import-skills-sh.ts",
    "skills:review": "node --import tsx scripts/review-skill-associations.ts",
    "skills:suggest": "node --import tsx scripts/suggest-skill-associations.ts",
