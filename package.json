    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.33.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-rsc": "^0.5.24",
    "react-server-dom-webpack": "19.2.5",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vinext": "0.0.43",
    "vite": "^8.0.2",
    "wrangler": "^4.43.0"
